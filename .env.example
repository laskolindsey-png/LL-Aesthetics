# Copy this file to ".env" and fill in real values.

# PostgreSQL connection string. Locally you can run Postgres in Docker; in
# production (Fly.io) this is provided automatically as a secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ll_aesthetics?schema=public"

# Secret used to sign login sessions. Must be 16+ characters and kept private.
# Generate a strong one, e.g.:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The first owner login, created automatically on a fresh database.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
